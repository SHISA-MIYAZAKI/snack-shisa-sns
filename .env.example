# キャプション自動生成用（Claude API）
ANTHROPIC_API_KEY=

# Instagram Graph API（Business/Creatorアカウント + Facebookページ連携が必要）
IG_USER_ID=
IG_ACCESS_TOKEN=

# Threads API（Meta開発者アプリに「Threads API」ユースケースの追加が必要）
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# X (Twitter) API v2（書き込み権限付きのアプリ・トークンが必要）
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
